# DataForSEO (paid, pay-as-you-go) for keyword rankings and search volumes.
# Copy this file to .env, fill in both values, then rebuild (npm run build or npm run watch).
# Find them at https://app.dataforseo.com/api-access ("API login" and "API password").
# The API password is NOT the password you sign in to the DataForSEO website with.
# Leave them empty to use the free Google-tab method instead.
# Note: these are built into the extension files, so only share the built extension inside the team.
VITE_DATAFORSEO_LOGIN=
VITE_DATAFORSEO_PASSWORD=
